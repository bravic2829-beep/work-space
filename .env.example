# Copy to .env and adjust. Never commit .env or real secrets.

# --- Backend ---
APP_ENV=local
# Comma-separated list of exact origins. Wildcard "*" is rejected by the backend.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL (used by docker-compose and the backend) ---
POSTGRES_USER=workbase
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=workbase
POSTGRES_PORT=55432
# asyncpg driver. Keep user, password, db and port in sync with the values above.
# Use 127.0.0.1, not "localhost": on Windows "localhost" adds about 2 seconds to every connection.
DATABASE_URL=postgresql+asyncpg://workbase:change_me_local_only@127.0.0.1:55432/workbase

# --- Authentication (see docs/adr/0001) ---
# Secret that signs session tokens (at least 32 characters). The backend refuses to start
# outside tests while this still starts with "change_me".
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_generate_a_long_random_value_here
# true when served over HTTPS (production), false for plain http://localhost
COOKIE_SECURE=false
